# Copie este arquivo para .env e ajuste os valores conforme necessário.
#   cp .env.example .env

# ── Porta ─────────────────────────────────────────────────────────────────────
# Porta de escuta da instância da API. O load balancer (Nginx) usa a porta 9999.
PORT=8080

# ── Logging ───────────────────────────────────────────────────────────────────
# Nível mínimo de log emitido pelo servidor.
# Valores aceitos: debug | info | warn | error
# Padrão: info
LOG_LEVEL=info

# ── Backend de busca vetorial ──────────────────────────────────────────────────
# Seleciona o algoritmo usado para encontrar os k vizinhos mais próximos.
#
# brute — brute-force exato O(N) via mmap; vetores compartilhados entre instâncias
#          pelo page cache do kernel. Padrão e mais seguro para o budget de 350 MB.
#
# hnsw  — HNSW aproximado O(log N). O servidor detecta automaticamente se
#          resources/references.hnsw existe (gerado pelo cmd/preprocess / Dockerfile):
#            presente → hnsw.Load  (startup rápido; ~170 MB heap extra por instância)
#            ausente  → hnsw.Open  (build O(N log N); vetores no mmap, menos memória)
#
# ivf   — IVF-SQ8 aproximado O(nprobe·N/nlist). Requer resources/references.ivf
#          (gerado com BUILD_IVF=true); Fatal na startup se o arquivo estiver ausente.
#          Usa ~45 MB de heap por instância — o mais econômico entre os backends ANN.
VECTOR_SEARCHER=brute

# ── Parâmetros IVF-SQ8 (runtime) ──────────────────────────────────────────────
# Número de clusters pesquisados por query com VECTOR_SEARCHER=ivf.
# Com nlist=1024 e nprobe=32, ~3% do dataset é varrido por query (~30× mais rápido
# que brute-force). Dobre o nprobe para melhorar o recall com latência ~2× maior.
# Ignorado quando VECTOR_SEARCHER != ivf.
IVF_NPROBE=32

# ── Build do índice HNSW ───────────────────────────────────────────────────────
# Controla se o cmd/preprocess gera resources/references.hnsw durante o docker build.
# Passado como build arg (BUILD_HNSW) para o Dockerfile via docker-compose.
#
# true  — gera references.hnsw; necessário para VECTOR_SEARCHER=hnsw usar hnsw.Load
#          (startup rápido). Aumenta significativamente o tempo de build da imagem.
# false — pula a geração; references.hnsw não é incluído na imagem. Com
#          VECTOR_SEARCHER=hnsw, o servidor usa hnsw.Open (build O(N log N) no
#          startup, emite Warn no log).
BUILD_HNSW=false

# ── Build do índice IVF-SQ8 ───────────────────────────────────────────────────
# Controla se o cmd/preprocess gera resources/references.ivf durante o docker build.
# Passado como build arg (BUILD_IVF) para o Dockerfile via docker-compose.
#
# true  — gera references.ivf; obrigatório para VECTOR_SEARCHER=ivf funcionar.
#          O tempo de build depende de IVF_NLIST e do número de CPUs disponíveis.
# false — pula a geração; VECTOR_SEARCHER=ivf causará Fatal na startup.
BUILD_IVF=false

# Número de clusters K-means para o índice IVF. Passado como build arg (IVF_NLIST).
# Regra de bolso: sqrt(N) — para N=3M, o padrão de 1024 é um bom ponto de partida.
# Mais clusters = melhor recall com mesmo nprobe, mas build mais lento e mais memória
# para os centroides (negligível: nlist × 14 × 4 bytes = 57 KB para nlist=1024).
IVF_NLIST=1024

# Habilita quantização SQ8 no índice IVF. Passado como build arg (IVF_SQ8).
# O valor é gravado no cabeçalho do arquivo; o servidor lê o flag do arquivo —
# não é necessário definir esta variável em runtime.
#
# true  — comprime float32 → uint8 por dimensão (~45 MB/instância).
#          Introduz um erro de aproximação proporcional ao passo de quantização
#          (range/255 por dimensão). Recomendado quando memória é o limitante.
# false — mantém vetores como float32 (~168 MB/instância).
#          Distâncias dentro de cada cluster são exatas; o erro residual do IVF
#          vem apenas da partição K-means, não da quantização.
IVF_SQ8=true
